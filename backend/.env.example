# URL of a locally running IOPaint server, used for AI bleed outpainting.
# Install: pip install iopaint
# Run (in a separate terminal, keep it running - loads the model once):
#   iopaint start --model=runwayml/stable-diffusion-inpainting --device=mps
# (use --device=cuda on an NVIDIA machine, or omit for CPU-only, much slower)
IOPAINT_API_URL=http://127.0.0.1:8080

# Path to the Upscayl CLI binary. If you installed the Upscayl desktop app
# (e.g. via `brew install --cask upscayl`), the CLI is bundled inside it:
#   /Applications/Upscayl.app/Contents/Resources/bin/upscayl-bin
# Alternatively install realesrgan-ncnn-vulkan directly and point this at it.
UPSCAYL_BIN_PATH=

# Folder of .bin/.param model files, and the model name to use. Required
# because the CLI's built-in default model (realesrgan-x4plus) isn't part of
# the set Upscayl bundles - use one of its bundled models instead, e.g. the
# desktop app's Resources/models folder with model name "upscayl-standard-4x".
UPSCAYL_MODELS_DIR=
UPSCAYL_MODEL_NAME=upscayl-standard-4x

# Directory where per-upload job folders (original/intermediate/final images) are written.
JOBS_DIR=./jobs
