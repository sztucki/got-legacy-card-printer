# Required for the bleed-generation step (OpenAI images edit/outpaint call)
OPENAI_API_KEY=

# Path to the Upscayl CLI binary. If you installed the Upscayl desktop app,
# the CLI is bundled inside it, e.g. on macOS:
#   /Applications/upscayl.app/Contents/Resources/bin/upscayl-bin
# Alternatively install realesrgan-ncnn-vulkan directly and point this at it.
UPSCAYL_BIN_PATH=

# Directory where per-upload job folders (original/intermediate/final images) are written.
JOBS_DIR=./jobs
